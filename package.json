{
  "name": "charter-ai",
  "displayName": "Charter Ai",
  "description": "Charter Ai — AI-assisted requirements pipeline (Charter → PRD → System Design → Dev → QA → Post Dev)",
  "version": "1.0.0",
  "publisher": "charter-ai",
  "private": true,
  "type": "module",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.cjs",
  "contributes": {
    "commands": [
      {
        "command": "charter-ai.openPipeline",
        "title": "Charter Ai: Open Pipeline"
      },
      {
        "command": "charter-ai.initializeWorkspace",
        "title": "Charter Ai: Initialize Workspace"
      },
      {
        "command": "charter-ai.configureApiKey",
        "title": "Charter Ai: Configure API Key"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "charter-ai.openPipeline"
        },
        {
          "command": "charter-ai.initializeWorkspace"
        },
        {
          "command": "charter-ai.configureApiKey"
        }
      ]
    }
  },
  "scripts": {
    "dev": "vite",
    "build:webview": "vite build",
    "build:extension": "esbuild extension/extension.ts --bundle --outfile=out/extension.cjs --external:vscode --external:mermaid --external:@vscode/ripgrep --format=cjs --platform=node --tsconfig=tsconfig.extension.json",
    "build": "npm run build:extension && npm run build:webview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "preview": "vite preview",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "@blocknote/core": "^0.52.1",
    "@blocknote/mantine": "^0.52.1",
    "@blocknote/react": "^0.52.1",
    "@mantine/core": "^9.4.2",
    "@mantine/hooks": "^9.4.2",
    "@vscode/ripgrep": "^1.18.0",
    "fast-glob": "^3.3.3",
    "mermaid": "^11.16.0",
    "openai": "^4.104.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.125.0",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.0.12",
    "vitest": "^4.1.10"
  }
}
